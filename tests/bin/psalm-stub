#!/usr/bin/env php
<?php

declare(strict_types=1);

// Stub "psalm" executable used by the PsalmTester tests; emits JSON on stdout for the argv
// entries that exist on disk. Behavior comes from the environment (STUB_*), which is shared by
// every group of a batch, or per invocation from --stub-* arguments in a group's argument string:
//   --stub-sleep=<seconds>    overrides STUB_SLEEP
//   --stub-mode=<mode>        overrides STUB_MODE
//   --stub-await-pids=<n>     first wait until STUB_PID_DIR holds <n> pid files
// STUB_PID_DIR: each invocation writes its pid there. STUB_STDERR: text written to stderr.
// STUB_STDERR_BYTES: that many bytes written to stderr. STUB_POPULATE_CACHE: nested files
// written under XDG_CACHE_HOME, as a real cache would be.

$options = [];
foreach ($argv as $arg) {
    if (\is_string($arg) && \preg_match('/^--stub-([a-z-]+)=(.*)$/', $arg, $m) === 1) {
        $options[$m[1]] = $m[2];
    }
}

$pidDir = (string) \getenv('STUB_PID_DIR');
if ($pidDir !== '') {
    \file_put_contents($pidDir . '/' . \getmypid(), '');
    $awaitPids = (int) ($options['await-pids'] ?? 0);
    while (\count(\glob($pidDir . '/*') ?: []) < $awaitPids) {
        \usleep(10_000);
    }
}

if (\getenv('STUB_POPULATE_CACHE') !== false) {
    $nested = (string) \getenv('XDG_CACHE_HOME') . '/psalm/nested/deeper';
    @\mkdir($nested, 0777, true);
    \file_put_contents($nested . '/entry.cache', 'cached');
}

$sleep = (float) ($options['sleep'] ?? (\getenv('STUB_SLEEP') ?: '0'));
if ($sleep > 0) {
    \usleep((int) ($sleep * 1_000_000));
}

$stderrBytes = (int) \getenv('STUB_STDERR_BYTES');
if ($stderrBytes > 0) {
    \fwrite(\STDERR, \str_repeat('e', $stderrBytes));
}

$stderr = (string) \getenv('STUB_STDERR');
if ($stderr !== '') {
    \fwrite(\STDERR, $stderr);
}

$mode = (string) ($options['mode'] ?? (\getenv('STUB_MODE') ?: 'per_file'));

if ($mode === 'invalid_json') {
    \fwrite(\STDOUT, 'NOT JSON');
    exit(0);
}

if ($mode === 'spawn_grandchild') {
    // Mimics Psalm's own PsalmRestarter: this process spawns an independent child (via
    // proc_open, not pcntl_exec, so it does NOT replace this process) and then blocks,
    // as if waiting on a re-exec'd child running the real analysis. Killing only this
    // process leaves that child running, orphaned under init.
    $pidFile = (string) \getenv('STUB_GRANDCHILD_PID_FILE');
    $grandchildScript = 'file_put_contents(' . \var_export($pidFile, true) . ', (string) getmypid()); sleep(30);';
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $pipes = [];
    $grandchild = \proc_open([\PHP_BINARY, '-r', $grandchildScript], $descriptors, $pipes);
    if (\is_resource($grandchild)) {
        \fclose($pipes[0]);
        \fclose($pipes[1]);
        \fclose($pipes[2]);
    }
    \sleep(30);
    \fwrite(\STDOUT, '[]');
    exit(0);
}

if ($mode === 'env_record') {
    $logDir = (string) \getenv('STUB_ENV_LOG_DIR');
    if ($logDir !== '' && \is_dir($logDir)) {
        $payload = [
            'pid' => \getmypid(),
            'XDG_CACHE_HOME' => (string) \getenv('XDG_CACHE_HOME'),
            'TMPDIR' => (string) \getenv('TMPDIR'),
            'TMP' => (string) \getenv('TMP'),
            'TEMP' => (string) \getenv('TEMP'),
            'sys_get_temp_dir' => \sys_get_temp_dir(),
            'argv' => \array_slice($argv, 1),
        ];
        \file_put_contents(
            $logDir . '/' . \getmypid() . '_' . \bin2hex(\random_bytes(4)) . '.json',
            (string) \json_encode($payload),
        );
    }
    \fwrite(\STDOUT, '[]');
    exit(0);
}

/** @var list<string> $files */
$files = [];
foreach (\array_slice($argv, 1) as $arg) {
    if (\is_string($arg) && \is_file($arg)) {
        $files[] = $arg;
    }
}

$errors = [];
if ($mode === 'large') {
    foreach ($files as $file) {
        for ($i = 0; $i < 3000; $i++) {
            $errors[] = [
                'type' => 'BigError',
                'line_from' => 1,
                'column_from' => 1,
                'message' => 'padding ' . \str_repeat('x', 200),
                'file_path' => $file,
            ];
        }
    }
} elseif ($mode === 'echo_code') {
    // The message is the file's own code minus the open tag, so each id's output is distinct.
    foreach ($files as $file) {
        $errors[] = [
            'type' => 'StubError',
            'line_from' => 1,
            'column_from' => 1,
            'message' => \trim(\str_replace('<?php', '', (string) \file_get_contents($file))),
            'file_path' => $file,
        ];
    }
} else {
    foreach ($files as $file) {
        $errors[] = [
            'type' => 'StubError',
            'line_from' => 1,
            'column_from' => 1,
            'message' => 'stub error for ' . \basename($file),
            'file_path' => $file,
        ];
    }
}

\fwrite(\STDOUT, (string) \json_encode($errors));
