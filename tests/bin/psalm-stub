#!/usr/bin/env php
<?php

declare(strict_types=1);

// Stub "psalm" executable used by PsalmTesterBatchTest. Reads STUB_SLEEP / STUB_MODE
// from the environment; emits JSON on stdout. Files are the argv entries that exist on disk.
//
// STUB_SLEEP is process-wide env, so it sleeps every concurrently-run group identically.
// A --stub-sleep=<seconds> CLI arg overrides it per invocation, letting a single PsalmTest's
// `arguments` string make just its own group slow (e.g. to test per-group timeouts).

$sleep = (float) (\getenv('STUB_SLEEP') ?: '0');
foreach ($argv as $arg) {
    if (\is_string($arg) && \str_starts_with($arg, '--stub-sleep=')) {
        $sleep = (float) \substr($arg, \strlen('--stub-sleep='));
    }
}
if ($sleep > 0) {
    \usleep((int) ($sleep * 1_000_000));
}

$mode = (string) (\getenv('STUB_MODE') ?: 'per_file');

if ($mode === 'invalid_json') {
    \fwrite(\STDOUT, 'NOT JSON');
    exit(0);
}

if ($mode === 'spawn_grandchild') {
    // Mimics Psalm's own PsalmRestarter: this process spawns an independent child (via
    // proc_open, not pcntl_exec, so it does NOT replace this process) and then blocks,
    // as if waiting on a re-exec'd child running the real analysis. Killing only this
    // process leaves that child running, orphaned under init.
    $pidFile = (string) \getenv('STUB_GRANDCHILD_PID_FILE');
    $grandchildScript = 'file_put_contents(' . \var_export($pidFile, true) . ', (string) getmypid()); sleep(30);';
    $descriptors = [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $pipes = [];
    $grandchild = \proc_open([\PHP_BINARY, '-r', $grandchildScript], $descriptors, $pipes);
    if (\is_resource($grandchild)) {
        \fclose($pipes[0]);
        \fclose($pipes[1]);
        \fclose($pipes[2]);
    }
    \sleep(30);
    \fwrite(\STDOUT, '[]');
    exit(0);
}

if ($mode === 'env_record') {
    $logDir = (string) \getenv('STUB_ENV_LOG_DIR');
    if ($logDir !== '' && \is_dir($logDir)) {
        $payload = [
            'pid' => \getmypid(),
            'XDG_CACHE_HOME' => (string) \getenv('XDG_CACHE_HOME'),
            'TMPDIR' => (string) \getenv('TMPDIR'),
            'TMP' => (string) \getenv('TMP'),
            'TEMP' => (string) \getenv('TEMP'),
            'sys_get_temp_dir' => \sys_get_temp_dir(),
        ];
        \file_put_contents(
            $logDir . '/' . \getmypid() . '_' . \bin2hex(\random_bytes(4)) . '.json',
            (string) \json_encode($payload),
        );
    }
    \fwrite(\STDOUT, '[]');
    exit(0);
}

/** @var list<string> $files */
$files = [];
foreach (\array_slice($argv, 1) as $arg) {
    if (\is_string($arg) && \is_file($arg)) {
        $files[] = $arg;
    }
}

if ($mode === 'record_contents') {
    // One JSON log per invocation listing the analyzed files' contents, so a test can tell
    // which fixtures were analyzed (the files themselves are hash-named temp copies).
    $logDir = (string) \getenv('STUB_CONTENTS_LOG_DIR');
    \file_put_contents(
        $logDir . '/' . \getmypid() . '_' . \bin2hex(\random_bytes(4)) . '.json',
        (string) \json_encode(\array_map(static fn(string $file): string => (string) \file_get_contents($file), $files)),
    );
    \fwrite(\STDOUT, '[]');
    exit(0);
}

$errors = [];
if ($mode === 'large') {
    foreach ($files as $file) {
        for ($i = 0; $i < 3000; $i++) {
            $errors[] = [
                'type' => 'BigError',
                'line_from' => 1,
                'column_from' => 1,
                'message' => 'padding ' . \str_repeat('x', 200),
                'file_path' => $file,
            ];
        }
    }
} else {
    foreach ($files as $file) {
        $errors[] = [
            'type' => 'StubError',
            'line_from' => 1,
            'column_from' => 1,
            'message' => 'stub error for ' . \basename($file),
            'file_path' => $file,
        ];
    }
}

\fwrite(\STDOUT, (string) \json_encode($errors));
