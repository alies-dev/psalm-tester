{
    "name": "alies-dev/psalm-tester",
    "description": "Run Psalm on .phpt fixture files from PHPUnit to test Psalm plugins, stubs and type inference",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "phpt",
        "phpunit",
        "psalm",
        "psalm-plugin",
        "static analysis",
        "testing",
        "type-testing"
    ],
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com",
            "role": "Original Author"
        },
        {
            "name": "Alies Lapatsin",
            "email": "github@alies.dev",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/alies-dev/psalm-tester",
    "support": {
        "issues": "https://github.com/alies-dev/psalm-tester/issues",
        "source": "https://github.com/alies-dev/psalm-tester"
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2",
        "phpunit/phpunit": "^11 || ^12 || ^13",
        "vimeo/psalm": "^6.10 || ^7.0.0-beta16"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpyh/coding-standard": "^2.6",
        "psalm/plugin-phpunit": "^0.19.5 || ^0.20.0",
        "rector/rector": "^2.3",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "AliesDev\\PsalmTester\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AliesDev\\PsalmTester\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "scripts": {
        "dependency-analyser": "composer-dependency-analyser",
        "fixcs": "php-cs-fixer fix --diff --verbose",
        "pre-command-run": "mkdir -p var",
        "psalm": "psalm --show-info=true --no-diff",
        "rector": "rector process",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "dependency-analyser": "Check for unused, shadow and misplaced Composer dependencies.",
        "fixcs": "Fix code style with PHP CS Fixer.",
        "pre-command-run": "Ensure var/ exists before commands that write to it.",
        "psalm": "Run Psalm static analysis.",
        "rector": "Apply Rector refactorings.",
        "test": "Run the PHPUnit test suite."
    }
}
